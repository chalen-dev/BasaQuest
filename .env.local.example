VITE_SUPABASE_ANON_KEY=your-local-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here

# Optional. JSON array of admin accounts to seed, e.g.
# [{"username":"chael","name":"Chael Lusaya","password":"a-real-password"}]
# Leave unset to fall back to a throwaway dev admin (admin / basaquest).
SEED_ADMIN_ACCOUNTS_JSON='[
  {"username":"chael","name":"Chael Lusaya","password":"real-password-1"},
  {"username":"teammate2","name":"Teammate Two","password":"real-password-2"}
]'


